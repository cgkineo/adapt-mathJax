{
  "type": "object",
  "$schema": "http://json-schema.org/draft-03/schema",
  "id": "http://jsonschema.net",
  "properties": {
    "pluginLocations": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "_mathJax": {
              "type": "object",
              "legend": "MathJax",
              "properties": {
                "_isEnabled": {
                  "type": "boolean",
                  "default": true,
                  "title": "Enable MathJax",
                  "inputType": "Checkbox",
                  "help": "Whether this course may load MathJax at all. Left enabled, the library is loaded only where the course content actually contains maths"
                },
                "_forceLoad": {
                  "type": "boolean",
                  "default": false,
                  "title": "Always load MathJax",
                  "inputType": "Checkbox",
                  "help": "Loads MathJax even where no maths is found in the course content. Only needed where equations are injected at runtime by another plugin, which the content scan cannot see"
                },
                "_src": {
                  "type": "string",
                  "title": "Source",
                  "inputType": "Text",
                  "help": "Leave empty to use the MathJax version supplied with this plugin, which works offline. Set this only to load a different major version, and set In-line config to a matching configuration at the same time"
                },
                "_inlineConfig": {
                  "type": "object",
                  "title": "In-line config",
                  "inputType": {
                    "type": "CodeEditor",
                    "mode": "json"
                  },
                  "help": "Leave empty to use the configuration supplied with this plugin. Set as window.MathJax before the library loads, so its shape is specific to the MathJax major version named by Source — set the two together or neither"
                },
                "_loadTimeout": {
                  "type": "number",
                  "default": 10000,
                  "title": "Load timeout",
                  "inputType": "Number",
                  "help": "How long, in milliseconds, to wait for MathJax to become ready before giving up and continuing the course without typesetting"
                }
              }
            }
          }
        }
      }
    }
  }
}
